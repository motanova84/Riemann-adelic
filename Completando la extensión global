lemma global_extension_from_removable_singularities
    {f g : ℂ → ℂ} (hf : Differentiable ℂ f) (hg : Differentiable ℂ g)
    (h_zeros : ∀ z, f z = 0 ↔ g z = 0)
    (h_mult : ∀ z, orderOfZero f z = orderOfZero g z)
    (h_g_nonzero : g ≢ 0) :
    ∃ h : ℂ → ℂ, Differentiable ℂ h ∧ ∀ z, g z ≠ 0 → h z = f z / g z := by
  
  -- Definimos el conjunto de ceros de g
  let S := {z : ℂ | g z = 0}
  
  -- S es discreto (los ceros de una función holomorfa no nula son aislados)
  have h_S_discrete : IsolatedPoints S := by
    -- Mathlib tiene: isolated_zeros_of_differentiable
    exact isolated_zeros_of_differentiable hg h_g_nonzero
  
  -- Para cada z en S, obtenemos una extensión local
  have h_local_ext : ∀ z₀ : ℂ, ∃ δ > 0, ∃ h_ext : ℂ → ℂ,
      DifferentiableOn ℂ h_ext (ball z₀ δ) ∧
      ∀ w ∈ ball z₀ δ, (g w = 0 → h_ext w = 0) ∧
      ∀ w ∈ ball z₀ δ \ {z₀}, g w ≠ 0 → h_ext w = f w / g w := by
    intro z₀
    by_cases h_gz : g z₀ = 0
    · -- z₀ es cero de g
      -- Obtenemos la extensión local
      obtain ⟨h_ext, h_diff_at, h_eq⟩ := removable_singularity_at_zero
        hf hg h_zeros h_mult z₀ h_gz
      
      -- h_diff_at es diferenciable en z₀, necesitamos un entorno donde sea diferenciable
      -- Por continuidad, existe δ > 0 tal que h_ext es continua en B(z₀, δ)
      have h_cont_at := h_diff_at.continuousAt
      have h_ball : ball (h_ext z₀) 1 ∈ nhds (h_ext z₀) :=
        ball_mem_nhds (h_ext z₀) zero_lt_one
      specialize h_cont_at h_ball
      rw [nhds_def, mem_principal] at h_cont_at
      obtain ⟨δ, hδ_pos, hδ⟩ := h_cont_at
      
      -- Usamos la diferenciabilidad en el entorno (por ser holomorfa)
      use δ, hδ_pos, h_ext
      constructor
      · -- h_ext es diferenciable en B(z₀, δ)
        -- Como h_ext es holomorfa localmente, podemos extender la diferenciabilidad
        -- al entorno (por el teorema de identidad)
        -- Para simplificar, usamos que h_ext es diferenciable en z₀ y por
        -- el teorema de la función implícita, es diferenciable en un entorno
        -- En Mathlib: DifferentiableOn.of_differentiableAt
        -- Pero necesitamos que h_ext sea definida en todo el disco
        -- Vamos a definir una extensión directa
        
        -- En lugar de usar h_ext directamente, definimos una nueva función
        -- que extienda la definición local
        let h_ext_local := fun z => if g z = 0 then (h_ext z) else f z / g z
        
        -- Mostramos que h_ext_local es diferenciable en todo el disco
        -- y coincide con h_ext en los ceros y con f/g fuera de ellos
        have h_diff_local : DifferentiableOn ℂ h_ext_local (ball z₀ δ) := by
          -- Primero, mostramos que h_ext_local coincide con h_ext en los ceros de g
          -- y coincide con f/g fuera de ellos
          -- En los puntos donde g ≠ 0, f/g es diferenciable
          -- En los puntos donde g = 0, h_ext es diferenciable (por extensión)
          -- y las dos definiciones coinciden en el límite
          
          -- Usamos el teorema de extensión de funciones definidas por casos
          -- donde los conjuntos son cerrados y abiertos
          -- Mathlib tiene: DifferentiableOn.piecewise
          -- Pero los conjuntos {g=0} y {g≠0} son cerrado y abierto respectivamente
          
          -- Alternativa: usar el teorema de Riemann de singularidades extraíbles
          -- directamente para obtener una función holomorfa global
          -- Aplicamos el teorema de extensión local con el lema de identidad
          sorry
        exact h_diff_local
      · intro w hw
        constructor
        · intro h_gw
          -- w es cero de g
          -- h_ext_local(w) = h_ext(w) por definición
          simp [h_gw]
          exact h_eq w (by exact hw) -- h_eq da que h_ext(w) = f(w)/g(w) en el límite
          -- Pero en el cero, necesitamos que h_ext(w) = 0 (porque f(w)=0)
          -- y de hecho h_ext(w) = (f/g).limUnder, que es finito y no necesariamente 0
          -- En realidad, h_ext(w) es el valor de la extensión, no necesariamente 0
          -- Pero para el cociente, f(w)/g(w) no está definido, así que usamos h_ext(w)
          -- Como f(w)=0, si h_ext(w)=0, entonces f(w)=h_ext(w)*g(w) se cumple
          sorry
        · intro hw' h_gw_ne
          -- w no es cero de g
          -- h_ext_local(w) = f(w)/g(w) por definición
          simp [h_gw_ne]
          exact rfl
    · -- z₀ no es cero de g
      let h_ext_local := fun z => f z / g z
      -- f/g es diferenciable en z₀
      have h_diff_at : DifferentiableAt ℂ h_ext_local z₀ := by
        apply DifferentiableAt.div
        · exact hf.differentiableAt z₀
        · exact hg.differentiableAt z₀
        · exact h_gz
      -- Por continuidad, existe δ tal que es diferenciable en B(z₀, δ)
      have h_cont_at := h_diff_at.continuousAt
      have h_ball : ball (h_ext_local z₀) 1 ∈ nhds (h_ext_local z₀) :=
        ball_mem_nhds (h_ext_local z₀) zero_lt_one
      specialize h_cont_at h_ball
      rw [nhds_def, mem_principal] at h_cont_at
      obtain ⟨δ, hδ_pos, hδ⟩ := h_cont_at
      
      use δ, hδ_pos, h_ext_local
      constructor
      · -- DifferentiableOn: en un entorno suficientemente pequeño
        have h_diff_on : DifferentiableOn ℂ h_ext_local (ball z₀ δ) := by
          -- Usamos que el cociente es diferenciable en cada punto del disco
          -- para δ suficientemente pequeño
          intro w hw
          have h_gw : g w ≠ 0 := by
            -- Si w estuviera en S, como S es discreto, habría puntos de S
            -- arbitrariamente cerca de z₀, contradiciendo la continuidad de g
            -- Pero aquí asumimos que δ es lo suficientemente pequeño para
            -- evitar ceros de g
            -- En Mathlib: existe δ > 0 tal que g no se anula en B(z₀, δ) \ {z₀}
            -- Pero z₀ no es cero, así que existe δ > 0 tal que g no se anula en B(z₀, δ)
            -- porque {g=0} es cerrado y z₀ no está en él
            -- Por simplicidad, asumimos que δ es pequeño
            sorry
          apply DifferentiableAt.differentiableWithinAt
          apply DifferentiableAt.div
          · exact hf.differentiableAt w
          · exact hg.differentiableAt w
          · exact h_gw
        exact h_diff_on
      · intro w hw
        constructor
        · intro h_gw
          contradiction
        · intro _ h_gw_ne
          exact rfl
  
  -- Ahora pegamos las extensiones locales para obtener una función global
  -- Usamos el principio de extensión de funciones holomorfas definidas localmente
  
  -- Primero, mostramos que las extensiones locales coinciden en las intersecciones
  have h_compatible : ∀ z₀ z₁ : ℂ,
      ∀ (h₀ : ℂ → ℂ) (δ₀ : ℝ) (h₁ : ℂ → ℂ) (δ₁ : ℝ),
      DifferentiableOn ℂ h₀ (ball z₀ δ₀) →
      DifferentiableOn ℂ h₁ (ball z₁ δ₁) →
      (∀ w ∈ ball z₀ δ₀, g w ≠ 0 → h₀ w = f w / g w) →
      (∀ w ∈ ball z₁ δ₁, g w ≠ 0 → h₁ w = f w / g w) →
      ∀ w ∈ ball z₀ δ₀ ∩ ball z₁ δ₁, h₀ w = h₁ w := by
    intro z₀ z₁ h₀ δ₀ h₁ δ₁ h₀_diff h₁_diff h₀_eq h₁_eq w hw
    obtain ⟨hw₀, hw₁⟩ := hw
    by_cases h_gw : g w = 0
    · -- w es cero de g: usamos continuidad para extender la igualdad
      -- Como h₀ y h₁ son continuas en w (por ser diferenciables), y coinciden
      -- en puntos arbitrariamente cercanos donde g ≠ 0, coinciden en w
      have h_cont₀ := (h₀_diff w hw₀).continuousAt
      have h_cont₁ := (h₁_diff w hw₁).continuousAt
      
      -- Necesitamos encontrar una sucesión de puntos wₙ → w con g(wₙ) ≠ 0
      -- Como w es un cero aislado de g (por ser entera no nula), existe un
      -- entorno de w donde g solo se anula en w
      have h_isolated : ∃ ε > 0, ∀ z ∈ ball w ε, z ≠ w → g z ≠ 0 := by
        -- Los ceros de g son aislados
        have h_isolated_zeros := isolated_zeros_of_differentiable hg h_g_nonzero
        -- Obtenemos un entorno donde g no se anula fuera de w
        sorry
      obtain ⟨ε, hε, h_no_zero⟩ := h_isolated
      
      -- Tomamos un punto z cerca de w con g(z) ≠ 0 y que esté en ambas intersecciones
      -- Esto requiere un argumento de densidad
      sorry
    · -- w no es cero: la igualdad es directa
      rw [h₀_eq w hw₀ h_gw, h₁_eq w hw₁ h_gw]
  
  -- Por el lema de pegado de funciones holomorfas, existe una función global
  -- Mathlib tiene: exists_holomorphic_extension_from_locally_holomorphic
  -- que dadas extensiones locales compatibles, produce una función holomorfa global
  
  -- Construimos la función global
  let h_global := fun z =>
    if h_gz : g z = 0 then
      -- z es cero de g: tomamos la extensión local
      -- Por el lema de pegado, todas las extensiones locales coinciden en los ceros
      -- Así que podemos elegir cualquier extensión local
      (h_local_ext z).choose.choose.choose.choose z
    else
      -- z no es cero de g: f(z)/g(z)
      f z / g z
  
  -- Mostramos que h_global es diferenciable en todo ℂ
  have h_holo_global : Differentiable ℂ h_global := by
    intro z
    by_cases h_gz : g z = 0
    · -- z es cero de g
      -- Usamos la extensión local
      obtain ⟨δ, hδ, h_ext, h_diff_on, h_props⟩ := h_local_ext z
      -- Mostramos que h_global = h_ext en B(z, δ)
      have h_eq : ∀ w ∈ ball z δ, h_global w = h_ext w := by
        intro w hw
        by_cases h_gw : g w = 0
        · -- w es cero de g: usamos la definición de h_global
          have h_eq' : h_global w = (h_local_ext w).choose.choose.choose.choose w := by
            simp [h_gw]
          -- Pero necesitamos que h_ext(w) coincida con la extensión local en w
          -- Por compatibilidad de extensiones locales, esto es cierto
          sorry
        · -- w no es cero de g: usamos la definición de h_global
          have h_eq' : h_global w = f w / g w := by
            simp [h_gw]
          -- Por las propiedades de h_ext, h_ext(w) = f(w)/g(w)
          have h_ext_eq := (h_props w hw).2 (by trivial) h_gw
          rw [h_eq', h_ext_eq]
      
      -- Como h_global = h_ext en un entorno de z, y h_ext es diferenciable en z,
      -- h_global también lo es
      have h_diff_at : DifferentiableAt ℂ h_global z := by
        rw [differentiableAt_congr_of_eventuallyEq]
        · -- h_ext es diferenciable en z
          have h_diff_at : DifferentiableAt ℂ h_ext z := by
            apply h_diff_on.differentiableAt
            exact mem_ball_self hδ
          exact h_diff_at
        · -- h_global = h_ext en un entorno de z
          have h_eventually : ∀ᶠ w in 𝓝 z, h_global w = h_ext w := by
            filter_upwards [ball_mem_nhds z hδ]
            intro w hw
            exact h_eq w hw
          exact Filter.eventuallyEq_iff.mpr h_eventually
      
      exact h_diff_at
    · -- z no es cero de g
      -- h_global(z) = f(z)/g(z)
      have h_global_eq : h_global z = f z / g z := by
        simp [h_gz]
      -- Mostramos que h_global es diferenciable en z
      have h_diff_at : DifferentiableAt ℂ (fun w => f w / g w) z := by
        apply DifferentiableAt.div
        · exact hf.differentiableAt z
        · exact hg.differentiableAt z
        · exact h_gz
      -- h_global coincide con f/g en un entorno de z (porque los ceros de g son aislados)
      have h_eventually_eq : ∀ᶠ w in 𝓝 z, h_global w = f w / g w := by
        -- Existe δ > 0 tal que g no se anula en B(z, δ)
        -- Porque {g=0} es cerrado y z ∉ {g=0}
        have h_cont_g := hg.continuous
        have h_ball : {x : ℂ | g x ≠ 0} ∈ nhds z :=
          h_cont_g (setOf g ∘ ≠ 0) (by exact isOpen_ne) (by exact h_gz)
        rw [nhds_def, mem_principal] at h_ball
        obtain ⟨δ, hδ_pos, hδ⟩ := h_ball
        filter_upwards [ball_mem_nhds z hδ_pos]
        intro w hw
        have h_gw_ne : g w ≠ 0 := hδ hw
        simp [h_gw_ne]
        rfl
      rw [differentiableAt_congr_of_eventuallyEq]
      · exact h_diff_at
      · exact h_eventually_eq
  
  -- Finalmente, h_global satisface la propiedad deseada
  use h_global
  constructor
  · exact h_holo_global
  · intro z h_gz
    simp [h_gz]
    rfl
