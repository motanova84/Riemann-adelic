lemma global_extension_from_removable_singularities
    {f g : ℂ → ℂ} (hf : Differentiable ℂ f) (hg : Differentiable ℂ g)
    (h_zeros : ∀ z, f z = 0 ↔ g z = 0)
    (h_mult : ∀ z, orderOfZero f z = orderOfZero g z)
    (h_g_nonzero : g ≢ 0) :
    ∃ h : ℂ → ℂ, Differentiable ℂ h ∧ ∀ z, g z ≠ 0 → h z = f z / g z := by
  -- Definimos h(z) = f(z)/g(z) cuando g(z) ≠ 0, y extendemos por continuidad en los ceros
  let S := {z : ℂ | g z = 0}
  -- S es discreto (g es entera no nula)
  have h_discrete : IsolatedPoints S := by
    -- Los ceros de una función holomorfa no nula son aislados
    exact isPreconnected_iff_connected  -- No, esto no es correcto
    -- El teorema correcto: isolatedZeros hg h_g_nonzero
    exact isolated_zeros_of_differentiable hg h_g_nonzero
  -- Definimos h por casos
  have h_local_ext : ∀ z : ℂ, ∃ δ > 0, ∃ hz : ℂ → ℂ,
      DifferentiableOn ℂ hz (ball z δ) ∧
      ∀ w ∈ ball z δ, (g w ≠ 0 → hz w = f w / g w) ∧
      (g w = 0 → hz w = (f w / g w).limUnder (𝓝[≠] w)) := by
    intro z
    by_cases h_gz : g z = 0
    · -- z es cero de g, aplicamos extensión local
      obtain ⟨h_ext, h_diff_at, h_eq⟩ := removable_singularity_at_zero
        hf hg h_zeros h_mult z h_gz
      -- h_diff_at es diferenciable en z, por continuidad existe δ tal que h_ext es diferenciable en B(z,δ)
      have h_diff_on : ∃ δ > 0, DifferentiableOn ℂ h_ext (ball z δ) := by
        -- Unicidad de la extensión: h_ext es diferenciable en un entorno de z
        -- Mathlib tiene: differentiableAt_iff_hasFDerivAt, de ahí obtenemos
        -- la existencia de un entorno donde la derivada está bien definida
        have h_cont_at := h_diff_at.continuousAt
        -- Existe δ tal que h_ext es continua en B(z,δ), y como es diferenciable en z,
        -- podemos extender la diferenciabilidad
        -- Por simplicidad, asumimos que podemos tomar el entorno
        sorry
      obtain ⟨δ, hδ, h_diff_on⟩ := h_diff_on
      use δ, hδ, h_ext
      intro w hw
      constructor
      · intro h_gw
        -- w no es cero, por el lema de extensión sabemos que h_ext(w) = f(w)/g(w)
        -- Pero h_eq solo da igualdad en el entorno perforado de z, no de w
        -- Si w es cualquier punto en B(z,δ), podemos aproximar por puntos cercanos
        -- y usar continuidad. O podemos usar el teorema de extensión global.
        -- Para simplificar, asumimos que h_eq se extiende a todo el disco
        sorry
      · intro h_gw
        -- w es cero, entonces h_ext(w) = (f/g).limUnder (𝓝[≠] w)
        -- Por unicidad de la extensión, esto es cierto
        sorry
    · -- z no es cero de g
      let hz := fun w => f w / g w
      have h_diff_at : DifferentiableAt ℂ hz z := by
        apply DifferentiableAt.div
        · exact hf.differentiableAt z
        · exact hg.differentiableAt z
        · exact h_gz
      have h_cont_at := h_diff_at.continuousAt
      obtain ⟨δ, hδ, h_cont⟩ := h_cont_at (ball (hz z) 1) (ball_mem_nhds (hz z) zero_lt_one)
      use δ, hδ, hz
      intro w hw
      constructor
      · exact fun _ => rfl
      · intro h_gw
        contradiction
  -- Ahora pegamos las extensiones locales para obtener una función global
  -- Como ℂ es conexo y las extensiones locales coinciden en intersecciones,
  -- podemos definir h global
  -- Este paso usa el lema de extensión de funciones definidas localmente
  -- Mathlib tiene: exists_extension_of_local_definitions
  sorry
